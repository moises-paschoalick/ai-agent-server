# Agent Server environment variables
#
# Copy to .env and fill in your values:  cp .env.example .env
# One .env at the monorepo root serves the backend (run from backend/ it also reads ../.env),
# the frontend's dev server and docker compose. .env is git-ignored.
# Never commit real keys.

# --- Server API keys ---------------------------------------------------------
# Keys that clients of THIS server send as "Authorization: Bearer <key>" (comma-separated).
# Every route except GET /health requires one. Empty = the server starts but answers 401.
# Generate one with: openssl rand -hex 24
AGENT_API_KEYS=

# --- Frontend ----------------------------------------------------------------
# One of AGENT_API_KEYS. Only the frontend's proxy (Vite in dev, nginx in the container) uses it;
# it is added to /api calls on the server side and never reaches the browser.
AGENT_API_KEY=
# Backend address for the dev server (npm run dev); docker compose sets its own.
# BACKEND_URL=http://localhost:8080
# Basic auth for the whole frontend: set both before exposing it publicly.
# FRONTEND_USER=
# FRONTEND_PASSWORD=

# --- LLM providers -----------------------------------------------------------
# A provider is active only when its key is set; empty keeps it inactive.
# The default provider (AGENT_LLM_DEFAULT) must have a key or the app won't start.

# OpenAI (default provider). LLM_API_KEY is still accepted for older setups.
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=

# xAI Grok (OpenAI-compatible)
XAI_API_KEY=

# --- Model selection ---------------------------------------------------------
# Default model as provider:model. Uncomment to change.
# (Older setups: AGENT_LLM_MODEL=gpt-5.4-mini still sets the OpenAI default model.)
# AGENT_LLM_DEFAULT=openai:gpt-5.4-mini

# Base URL of the "openai" provider (any OpenAI-compatible endpoint).
# AGENT_LLM_BASE_URL=https://api.openai.com/v1

# Models listed by GET /models (the frontend's selector), comma-separated, per active provider.
# The default model and the aliases are always listed.
# AGENT_OPENAI_MODELS=gpt-5.4-mini,gpt-5.4
# AGENT_ANTHROPIC_MODELS=claude-sonnet-4-5
# AGENT_GEMINI_MODELS=gemini-2.5-flash
# AGENT_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# AGENT_XAI_MODELS=

# --- Call settings -----------------------------------------------------------
# AGENT_LLM_TEMPERATURE=0.3
# AGENT_LLM_TIMEOUT=60s
# AGENT_LLM_MAX_RETRIES=2

# --- Agent engine ------------------------------------------------------------
# Server-side tool rounds per user message, and the optional system prompt of /chat.
# AGENT_MAX_TOOL_ROUNDS=10
# AGENT_CHAT_SYSTEM_PROMPT=You are a helpful assistant.

# --- Tools -------------------------------------------------------------------
# Directory of the tool catalog (tools.json) and time zone of the date/time system tool.
# AGENT_DATA_DIR=./data   (relative to where the backend runs: backend/data when run from backend/)
# AGENT_TIMEZONE=America/Sao_Paulo
# System tools in executions with an assistant: all (default) = every one; declared = only the ones it declares
# AGENT_SYSTEM_TOOLS_MODE=all

# --- /v1 assistants --------------------------------------------------------------
# true = saved in data/assistants.json; false = memory only (use for real/sensitive data)
# AGENT_ASSISTANTS_PERSIST=true

# --- Storage -----------------------------------------------------------------------
# memory (default) = conversations and runs in memory, assistants and tools in AGENT_DATA_DIR;
# postgres = everything in PostgreSQL (assistants, tools, threads, messages, runs, audit). On the first
# start with an empty database, assistants.json and tools.json are imported with the same ids.
# AGENT_STORE=postgres
# Railway form (postgresql://user:password@host:port/db) or jdbc:postgresql://...
# Compose (--profile postgres): postgresql://agent:agent@postgres:5432/agent
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=
# Credentials of the compose postgres service (change them outside local use)
# POSTGRES_USER=agent
# POSTGRES_PASSWORD=agent
# POSTGRES_DB=agent
# Audit events (GET /audit/events) older than this are deleted once a day
# AGENT_AUDIT_RETENTION=90d

# --- /v1 runs ------------------------------------------------------------------
# How long a run may wait in requires_action for tool outputs before it expires.
# AGENT_RUN_EXPIRES=600s

# --- Aliases (optional) ------------------------------------------------------
# agent.llm.aliases.fast.model=openrouter:meta-llama/llama-3.3-70b-instruct:free
# agent.llm.aliases.fast.temperature=0.2
